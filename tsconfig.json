{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "resolveJsonModule": true,
        "target": "ES2024",
        "jsx": "react-jsx",
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strict": true,
        "sourceMap": true,
        "types": [
            "node",
            "@playwright/test"
        ],
        "paths": {
            "@fixtures/*": [
                "./src/fixtures/*"
            ],
            "@pages/*": [
                "./src/pages/*"
            ],
            "@tests/*": [
                "./src/tests/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ]
        }
    },
    "include": [
        "*.ts",
        "*.mts",
        "src/fixtures/**/*.ts",
        "src/pages/**/*.ts",
        "src/tests/**/*.ts",
        "src/types/**/*.ts",
        "src/utils/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules/*",
        "dist",
        "report",
        "test-results"
    ]
}